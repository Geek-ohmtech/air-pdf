{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirPDF",
  "mainBinaryName": "air-pdf",
  "version": "0.5.0",
  "identifier": "kr.airpdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Air PDF",
        "width": 1280,
        "height": 860,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Air PDF",
    "shortDescription": "문서는 가볍게, 작업은 자유롭게 — Air PDF",
    "longDescription": "PDFium 엔진으로 빠르게 열고, 편집 모드에서 원본 글자 수정·주석·표·OCR을 지원하는 PDF 프로그램",
    "category": "Productivity",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "AirPDF.Document",
        "description": "PDF 문서",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": [
          "ko-KR",
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1OThGMjFBNEFGMDQ3NjAKUldSZ1IvQktHdktZWlJWbXZyeFdvZU5JaG5xWkx0UjZpenhSUldSSzF0WERReTU1VFFYZ3QxN2gK",
      "endpoints": [
        "https://raw.githubusercontent.com/Geek-ohmtech/air-pdf/main/release/latest.json",
        "https://github.com/Geek-ohmtech/air-pdf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}